# systemd unit for VM deployments. Install the jar at /opt/catalog-service/catalog-service.jar
# and the environment (CATALOG_DB_URL, CATALOG_ADMIN_PASSWORD, ...) in /etc/catalog-service/env.
[Unit]
Description=catalog-service
After=network-online.target
Wants=network-online.target

[Service]
User=catalog
EnvironmentFile=/etc/catalog-service/env
ExecStart=/usr/bin/java -jar /opt/catalog-service/catalog-service.jar --spring.profiles.active=prod
# Spring Boot exits with 143 after a graceful shutdown on SIGTERM
SuccessExitStatus=143
Restart=on-failure

[Install]
WantedBy=multi-user.target
